{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextstep-mentorship",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "nextstep-db",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "DEMO_MODE": "true",
    "SEED_DEMO_DATA": "false",
    "AI_MODEL": "gpt-6.2-sol"
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "nextstep-mentorship-production",
      "vars": { "DEMO_MODE": "false", "SEED_DEMO_DATA": "false", "AI_MODEL": "gpt-6.2-sol" },
      "triggers": { "crons": ["*/5 * * * *"] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "nextstep-prod",
        "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
        "migrations_dir": "migrations"
      }]
    }
  }
}
